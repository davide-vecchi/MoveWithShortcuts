REM Script to clean all the log files, temp files and "test-output" folder
REM that may be generated by the tests ran by the build or by the user.

@ECHO OFF

REM Set codepage to UTF-8 (CHCP 65001) :
CHCP 65001 >NUL

@ECHO ON

DEL /S /Q "*.LOG"

DEL /S /Q "*.TMP"


RMDIR /S /Q "test-output\"

PAUSE


CD /D "C:\MoveWithShortcuts"

DEL /S /Q "*.LOG"

DEL /S /Q "*.TMP"

PAUSE
